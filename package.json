{
  "name": "market-research",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && pnpm build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "worker": "node dist/worker.mjs",
    "worker:dev": "tsx src/workers/index.ts",
    "access": "tsx scripts/client-access.ts",
    "budget": "tsx scripts/acquisition-budget.ts",
    "synthesis:budget": "tsx scripts/synthesis-budget.ts",
    "synthesis:check": "tsx scripts/synthesis-config.ts",
    "deployment:check": "tsx scripts/check-client-owned-deployment.ts",
    "deployment:bootstrap": "tsx scripts/bootstrap-client-owned.ts",
    "legacy:inventory": "tsx scripts/legacy-inventory.ts",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "tsx --test integration/*.integration.ts",
    "check:governance": "node scripts/validate-product-governance.mjs",
    "check:source-of-truth": "node scripts/check-source-of-truth.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.3.3",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.24.0"
}
