# Audience Insights Engine — environment variables
#
# Copy to `.env.local` for local development. Real values are never committed;
# in production they are entered directly into SSM Parameter Store by someone
# with AWS SSO, per the platform's secret-handling convention.

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/audience_insights

# --- Session -------------------------------------------------------------------
# Secret used to sign the session cookie (HMAC-SHA256). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- OneLogin OIDC (Authorization Code + PKCE, Rule 7) ------------------------
# Discovery document URL for the OneLogin app, e.g.
#   https://bettercollective.onelogin.com/oidc/2/.well-known/openid-configuration
ONELOGIN_DISCOVERY_URL=
ONELOGIN_CLIENT_ID=
ONELOGIN_CLIENT_SECRET=
# Value of the OIDC groups/role claim that maps a signed-in user to the admin
# role. Any authenticated user whose claim does not match this value defaults
# to viewer (src/lib/auth.ts).
ONELOGIN_ADMIN_GROUP=admin

# --- Slack (channel delivery, Epic 5) ------------------------------------------
# Bot token for the Slack app used to list channels (conversations.list scope).
# Not yet provisioned.
# SLACK_BOT_TOKEN=

# --- Google Drive (channel delivery, Epic 5) -----------------------------------
# Service-account credentials JSON (single line) for a service account with
# the drive.readonly scope, used to search Drive folders. Not yet provisioned.
# Drive write access is a separate, longer-term gap (see product-spec.md) —
# this credential only supports read-only folder lookup.
# GOOGLE_DRIVE_CREDENTIALS_JSON=

# --- last30days engine (research runs, Epic 6) ---------------------------------
# Optional credentials for the vendored last30days engine's own sources
# (vendor/last30days — decisions/0002-last30days-subprocess.md), read by
# src/workers/runLast30Days.ts and passed through to the subprocess
# environment. Reddit, Hacker News, Polymarket, GitHub and YouTube all work
# keyless; these only unlock X and TikTok/ScrapeCreators coverage. Not yet
# provisioned.
# X_BEARER_TOKEN=
# XAI_API_KEY=
# SCRAPECREATORS_API_KEY=
