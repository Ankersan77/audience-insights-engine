# Market Research — environment variables
#
# Copy to `.env.local` for local development. Real values are never committed;
# production values belong in THIS CLIENT'S hosting provider's secret store.

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/market_research

# --- Session -------------------------------------------------------------------
# At least 32 characters, used to sign short-lived OIDC flow cookies. Sessions
# use random opaque tokens whose hashes, expiry and revocation live in PostgreSQL.
# Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
# Pin the public web origin in production, especially behind a reverse proxy.
# Cookie-authenticated API writes require a matching Origin header. If unset,
# the incoming request origin is used; the hosting proxy must validate Host.
APP_ORIGIN=

# --- OneLogin OIDC (Authorization Code + PKCE) --------------------------------
# Discovery document URL for the client's OneLogin application.
ONELOGIN_DISCOVERY_URL=
ONELOGIN_CLIENT_ID=
ONELOGIN_CLIENT_SECRET=
# Identity-provider groups do not grant application access. Provision the exact
# subject and tenant role explicitly using `pnpm access` (see the runbook).

# Fail-closed by default. When enabled, an opaque source credential reference of
# `env:MARKET_RESEARCH_SOURCE_KEY_CLIENT_<CLIENT_ID>_<NAME>` resolves from this
# client's worker secret store. It cannot read an arbitrary/global environment
# variable. Never put the secret value in source configuration or this file.
ENABLE_ENV_CREDENTIAL_RESOLVER=false

# Optional server-owned synthesis bindings; empty disables all model calls.
# See docs/synthesis-provider-acceptance.md. No model or allowance is auto-selected.
# Keys must use MARKET_RESEARCH_MODEL_KEY_CLIENT_<CLIENT_ID>_<NAME> in this
# client's secret store. One synthesis binding per installation.
# Do not put credential values in this JSON, solution profiles or source metadata.
MARKET_RESEARCH_SYNTHESIS_BINDINGS_JSON=

# --- Client tenancy -----------------------------------------------------------
# Required after provisioning: exact slug and numeric ID of the sole client in
# this installation's database. D4WN and each future customer have separate
# application/worker deployments, databases, identity configuration and keys.
MARKET_RESEARCH_CLIENT_SLUG=
MARKET_RESEARCH_CLIENT_ID=

# --- Canonical evidence policy ------------------------------------------------
# Minimum aggregate cohort; values below 2 fall back to the safe default (10).
MINIMUM_COHORT_SIZE=10
# Optional comma-separated additions to the built-in sensitive-content terms.
SENSITIVE_EVIDENCE_TERMS=

# Emergency switch for the bounded canonical maintenance schedule. Keep false
# in normal operation; see docs/operations-runbook.md for drain and rollback.
CANONICAL_MAINTENANCE_DISABLED=false
